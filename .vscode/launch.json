{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "STM32F103C8 (J-Link SWD)",
        "type": "cortex-debug",
        "request": "launch",
        "servertype": "jlink",
  
        "cwd": "${workspaceFolder}",
        "executable": "${workspaceFolder}/build_stm32f103/app",
  
        "device": "STM32F103C8",
        "interface": "swd",
        "speed": 4000,
  
        "gdbPath": "/Applications/ArmGNUToolchain/14.2.rel1/arm-none-eabi/bin/arm-none-eabi-gdb",
  
        "runToEntryPoint": "main",
        "breakAfterReset": true,
  
        "sourceFileMap": {
          "/Users/igor404ik/Documents/OSAL/OSAL": "${workspaceFolder}"
        },
  
        "showDevDebugOutput": "raw",
  
        "preLaunchCommands": [
          "monitor reset",
          "monitor halt"
        ],
        "postLaunchCommands": [
          "break main",
          "continue"
        ],
  
        "postRestartCommands": [
          "monitor reset",
          "monitor halt"
        ]
      }
    ]
  }
  